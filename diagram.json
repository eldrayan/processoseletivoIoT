{
  "version": 1,
  "author": "Elder Rayan",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": { "env": "micropython" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -100, "left": -100, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot2", "top": -100, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 100, "left": 50, "attrs": { "color": "blue" } },
    { "type": "wokwi-led", "id": "led2", "top": 100, "left": 150, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    [ "esp:GND.1", "pot1:GND", "black", [] ],
    [ "esp:3V3", "pot1:VCC", "red", [] ],
    [ "esp:34", "pot1:SIG", "green", [] ],
    
    [ "esp:GND.1", "pot2:GND", "black", [] ],
    [ "esp:3V3", "pot2:VCC", "red", [] ],
    [ "esp:35", "pot2:SIG", "blue", [] ],
    
    [ "esp:GND.1", "led1:C", "black", [] ],
    [ "esp:2", "led1:A", "blue", [] ],
    
    [ "esp:GND.1", "led2:C", "black", [] ],
    [ "esp:4", "led2:A", "red", [] ]
  ]
}