    { "type": "wokwi-potentiometer", "id": "pot_load", "top": -100, "left": 150, "attrs": { "label": "Carga CPU" } },
    { "type": "wokwi-led", "id": "led_cool", "top": 100, "left": 50, "attrs": { "color": "blue", "label": "Cooler" } },
